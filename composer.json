{
    "name": "bladeknigt89/yii2-dd",
    "description": "Laravel-compatible dd() and dump() for Yii2.",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "dd",
        "dump",
        "debug",
        "var-dumper",
        "laravel"
    ],
    "homepage": "https://github.com/bladeknigt89/yii2-dd",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Bánfalvi Gábor",
            "email": "banfalvi.gabor@pte.hu",
            "homepage": "https://github.com/bladeknigt89"
        }
    ],
    "support": {
        "issues": "https://github.com/bladeknigt89/yii2-dd/issues",
        "source": "https://github.com/bladeknigt89/yii2-dd"
    },
    "require": {
        "php": ">=8.1",
        "symfony/var-dumper": "^6.4 || ^7.0 || ^8.0",
        "yiisoft/yii2": "~2.0.45"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "bladeknigt89\\dd\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "bladeknigt89\\dd\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "extra": {
        "bootstrap": "bladeknigt89\\dd\\Bootstrap"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "test": "phpunit"
    }
}
